# Set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY (or AWS_PROFILE) to enable AWS adapters.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=

BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

DYNAMODB_GUARDIANS_TABLE=safeword-guardians
DYNAMODB_ALERTS_TABLE=safeword-alerts
DYNAMODB_SAFEWORDS_TABLE=safeword-safewords
SNS_TOPIC_ARN=

PORT=3000
NODE_ENV=development

# Frontend MCP endpoint (Vite uses /mcp through the local dev proxy by default)
VITE_MCP_SERVER_URL=http://localhost:3000/mcp
